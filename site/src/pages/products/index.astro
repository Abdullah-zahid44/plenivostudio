---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../config/products';
---

<Base
  title="Shop digital planners"
  description="Browse Digitali's offline digital planners. One-time purchase, no subscriptions — your data stays on your device."
  path="/products"
>
  <section class="section-tight">
    <div class="wrap">
      <p class="eyebrow">Shop</p>
      <h1>Digital planners, sold once</h1>
      <p class="lead">
        Every product below is a one-time purchase. No subscriptions, no accounts, no
        cloud — just a file you own.
      </p>
      <div style="margin: 2rem 0;">
        <label for="product-search" class="small" style="font-weight: 600; display: block; margin-bottom: 0.5rem;">
          Search products
        </label>
        <input
          type="search"
          id="product-search"
          class="search-input"
          placeholder="Search by name or feature…"
          autocomplete="off"
        />
      </div>
      <div id="product-list" style="display: grid; gap: 2rem;">
        {
          products.map((p) => (
            <div
              class="product-entry"
              data-search={`${p.name} ${p.tagline} ${p.features.join(' ')}`.toLowerCase()}
            >
              <ProductCard product={p} />
            </div>
          ))
        }
      </div>
      <p id="no-results" class="muted" hidden style="margin-top: 2rem;">
        No products match your search. Try a different term.
      </p>
    </div>
  </section>
</Base>

<script>
  const input = document.getElementById('product-search') as HTMLInputElement | null;
  const entries = Array.from(document.querySelectorAll('.product-entry'));
  const noResults = document.getElementById('no-results');

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    entries.forEach((el) => {
      const hay = (el as HTMLElement).dataset.search || '';
      const show = q === '' || hay.includes(q);
      (el as HTMLElement).hidden = !show;
      if (show) visible++;
    });
    if (noResults) noResults.hidden = visible > 0;
  });
</script>
