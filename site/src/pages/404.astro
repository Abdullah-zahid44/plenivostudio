---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The page you are looking for does not exist." path="/404" noindex>
  <section class="section">
    <div class="wrap" style="max-width: 640px; text-align: center;">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="muted">
        The page you are looking for does not exist or has been moved.
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 1.5rem;">
        <a class="btn btn-primary" href="/">Go home</a>
        <a class="btn btn-secondary" href="/products">Browse products</a>
      </div>
    </div>
  </section>
</Base>
