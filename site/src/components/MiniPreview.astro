---
/**
 * MiniPreview — a tiny live taste of the planner, placed near the hero.
 *
 * 5 habit dots as real <button>s that toggle on click (aria-pressed),
 * with an aria-live progress hint ("N of 5 done"). Clearly labeled as a
 * sample so it is never mistaken for the full product.
 * Vanilla JS in an Astro <script> tag — no dependencies.
 */
const habits = ['Drink water', 'Read 20 min', 'Walk', 'Journal', 'No sugar'];
---

<aside class="mini-preview card" aria-labelledby="mini-preview-heading" data-reveal="scale">
  <p class="eyebrow">A tiny taste</p>
  <h3 id="mini-preview-heading">Try it — this widget is live</h3>
  <ul class="habit-dots" role="list">
    {
      habits.map((habit, i) => (
        <li>
          <button
            type="button"
            class="habit-dot"
            data-habit-dot
            aria-pressed="false"
            aria-label={`Mark habit as done: ${habit}`}
          >
            <span class="dot" aria-hidden="true" />
            <span class="habit-name">{habit}</span>
          </button>
        </li>
      ))
    }
  </ul>
  <p class="progress-hint" aria-live="polite">
    <span data-progress-text>0 of 5 done</span>
  </p>
  <p class="small muted mini-note">
    The full planner has 17 views — this is just a sample.
  </p>
</aside>

<script is:inline>
  (function () {
    var root = document.querySelector('.mini-preview');
    if (!root) return;
    var dots = Array.prototype.slice.call(
      root.querySelectorAll('[data-habit-dot]')
    );
    var hint = root.querySelector('[data-progress-text]');
    if (!hint || dots.length === 0) return;

    function update() {
      var done = dots.filter(function (d) {
        return d.getAttribute('aria-pressed') === 'true';
      }).length;
      hint.textContent = done + ' of ' + dots.length + ' done';
    }

    dots.forEach(function (d) {
      d.addEventListener('click', function () {
        var pressed = d.getAttribute('aria-pressed') === 'true';
        d.setAttribute('aria-pressed', pressed ? 'false' : 'true');
        update();
      });
    });
  })();
</script>

<style>
  .mini-preview {
    max-width: 34rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    text-align: center;
    background: var(--card, #fff);
    border: 1px solid var(--line, #e5e3dc);
    border-radius: var(--radius, 12px);
  }
  .mini-preview h3 {
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.375rem;
    margin: 0.5rem 0 1.25rem;
  }
  .habit-dots {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    justify-content: center;
  }
  .habit-dot {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--line, #e5e3dc);
    border-radius: 999px;
    background: var(--paper, #faf8f3);
    color: var(--ink, #1c1a17);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
  }
  .habit-dot .dot {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 999px;
    border: 2px solid var(--indigo, #6554d9);
    background: transparent;
    flex: none;
  }
  .habit-dot[aria-pressed='true'] {
    border-color: var(--indigo, #6554d9);
    background: var(--lavender, #e9e6fb);
  }
  .habit-dot[aria-pressed='true'] .dot {
    background: var(--indigo, #6554d9);
  }
  .habit-dot:focus-visible {
    outline: 2px solid var(--indigo, #6554d9);
    outline-offset: 2px;
  }
  .progress-hint {
    font-weight: 600;
    margin: 0 0 0.5rem;
  }
  .mini-note {
    margin: 0;
  }
</style>
