---
/** Numbered "How it works" steps. Honest: purchase only exists once the store is active. */
interface Props {
  steps: { title: string; text: string }[];
}
const { steps } = Astro.props;
---

<ol class="steps">
  {
    steps.map((s, i) => (
      <li data-reveal="up" data-reveal-delay={String((i % 4) * 90)}>
        <span class="step-number" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3>{s.title}</h3>
        <p class="muted" style="margin: 0;">
          {s.text}
        </p>
      </li>
    ))
  }
</ol>

<style>
  /* ------------------------------------------------------------------
   * FALLBACK STYLES — how-it-works steps only.
   * Uses design-system hooks when present (--line, --lavender, --indigo,
   * --ink, --font-display, --radius). Additive if global.css already
   * covers .steps.
   * ------------------------------------------------------------------ */
  .steps {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 40rem) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .steps li {
    border: 1px solid var(--line, #e5e3dc);
    border-radius: var(--radius, 12px);
    background: var(--card, #fff);
    padding: 1.5rem;
  }
  .step-number {
    display: inline-block;
    font-family: var(--font-display, Georgia, serif);
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    color: var(--indigo, #6554d9);
    background: var(--lavender, #e9e6fb);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    margin-bottom: 0.875rem;
  }
  .steps h3 {
    font-size: 1.0625rem;
    margin: 0 0 0.5rem;
  }
</style>
