---
/**
 * Image with accessible alt text and lazy loading.
 * Screenshot files are generated from the real running planner
 * (see planner/packaging). Paths below must match public/screenshots/.
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  eager?: boolean;
  width?: number;
  height?: number;
}
const { src, alt, caption, eager = false, width = 1200, height = 800 } = Astro.props;
---

<figure class="hero-figure">
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
