---
/** Honest compatibility note — states what is tested, not "all devices". */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<aside class:list={['compat-note', { 'compat-note--compact': compact }]} aria-label="Compatibility note">
  <p class="compat-note__title">
    <strong>Compatibility, stated honestly.</strong>
  </p>
  <p class="small muted" style="margin: 0;">
    The planner is tested in recent Firefox and Chromium-based browsers on desktop,
    and in mobile Safari and Chrome for everyday use. It runs from a local file or
    any static host — no installation, no account, no internet needed after download.
    Browser storage can be restricted in some contexts (for example pages opened
    directly as files); in that case the planner tells you and offers export instead
    of losing data. See the included BROWSER-SUPPORT.md for the full tested matrix.
  </p>
</aside>

<style>
  .compat-note {
    background: var(--lavender-soft, #f3f1fd);
    border: 1px solid var(--lavender, #e9e6fb);
    border-left: 4px solid var(--indigo);
    border-radius: var(--radius);
    padding: 1.5rem 1.75rem;
  }
  .compat-note--compact {
    padding: 1.1rem 1.25rem;
  }
  .compat-note__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-ui);
    font-size: 1.05rem;
  }
</style>
