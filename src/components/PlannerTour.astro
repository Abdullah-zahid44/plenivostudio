---
/**
 * PlannerTour — tabbed tour of six planner views.
 *
 * Each tab shows a REAL screenshot from public/screenshots/ plus one honest
 * line about that view (real product facts only). Accessible tabs:
 * role=tablist/tab/tabpanel, aria-selected, aria-controls, arrow-key
 * navigation with roving tabindex.
 */

const views = [
  {
    id: 'today',
    label: 'Today',
    img: '/screenshots/planner-dashboard.png',
    alt: 'Today dashboard of the Ultimate Offline Life Planner, showing priorities, tasks and habit progress',
    line: "Your day at a glance — today's priorities, tasks and habit progress on one dashboard.",
  },
  {
    id: 'tasks',
    label: 'Tasks',
    img: '/screenshots/planner-tasks.png',
    alt: 'Tasks view of the Ultimate Offline Life Planner, showing tasks with priorities and due dates',
    line: 'Tasks with priorities, categories, due dates and simple recurrence.',
  },
  {
    id: 'weekly',
    label: 'Weekly',
    img: '/screenshots/planner-weekly.png',
    alt: 'Weekly view of the Ultimate Offline Life Planner, showing a seven-day task overview',
    line: 'A seven-day overview of your week, task by task.',
  },
  {
    id: 'budget',
    label: 'Budget',
    img: '/screenshots/planner-budget.png',
    alt: 'Budget view of the Ultimate Offline Life Planner, showing income and expense entries with monthly totals',
    line: 'Income and expenses with monthly totals. Informational only — not financial advice.',
  },
  {
    id: 'habits',
    label: 'Habits',
    img: '/screenshots/planner-habits.png',
    alt: 'Habits view of the Ultimate Offline Life Planner, showing habit tracking with streaks',
    line: 'Habit tracker with streaks and weekly statistics.',
  },
  {
    id: 'timer',
    label: 'Focus Timer',
    img: '/screenshots/planner-timer.png',
    alt: 'Focus Timer view of the Ultimate Offline Life Planner, showing a 25-minute focus session countdown',
    line: 'Focus sessions with short and long breaks, plus ambient warm noise.',
  },
];
---

<div class="tour" data-tour>
  <div class="tablist-wrap" role="tablist" aria-label="Planner views" data-tablist>
    {
      views.map((v, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${v.id}`}
          aria-controls={`panel-${v.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? '0' : '-1'}
          class="tour-tab"
        >
          {v.label}
        </button>
      ))
    }
  </div>

  {
    views.map((v, i) => (
      <div
        role="tabpanel"
        id={`panel-${v.id}`}
        aria-labelledby={`tab-${v.id}`}
        tabindex="0"
        hidden={i !== 0}
        class="tour-panel"
      >
        <figure class="tour-figure">
          <img
            src={v.img}
            alt={v.alt}
            width="1200"
            height="800"
            loading="lazy"
          />
          <figcaption class="small muted">
            Actual screenshot of the running planner
          </figcaption>
        </figure>
        <p class="tour-line">{v.line}</p>
      </div>
    ))
  }
</div>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-tour]');
    if (!root) return;
    var tablist = root.querySelector('[data-tablist]');
    var tabs = Array.prototype.slice.call(
      tablist.querySelectorAll('[role="tab"]')
    );
    var panels = Array.prototype.slice.call(
      root.querySelectorAll('[role="tabpanel"]')
    );
    if (tabs.length === 0) return;

    function activate(index, focus) {
      tabs.forEach(function (tab, i) {
        var selected = i === index;
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
        if (focus && selected) tab.focus();
      });
      panels.forEach(function (panel, i) {
        if (i === index) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () {
        activate(i, false);
      });
      tab.addEventListener('keydown', function (e) {
        var key = e.key;
        var next = null;
        if (key === 'ArrowRight' || key === 'ArrowDown') {
          next = (i + 1) % tabs.length;
        } else if (key === 'ArrowLeft' || key === 'ArrowUp') {
          next = (i - 1 + tabs.length) % tabs.length;
        } else if (key === 'Home') {
          next = 0;
        } else if (key === 'End') {
          next = tabs.length - 1;
        }
        if (next !== null) {
          e.preventDefault();
          activate(next, true);
        }
      });
    });
  })();
</script>

<style>
  .tour {
    margin-top: 1.5rem;
  }
  .tablist-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 1.75rem;
  }
  .tour-tab {
    font: inherit;
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.625rem 1.125rem;
    border: 1px solid var(--line, #e5e3dc);
    border-radius: 999px;
    background: var(--card, #fff);
    color: var(--ink, #1c1a17);
    cursor: pointer;
  }
  .tour-tab[aria-selected='true'] {
    background: var(--ink, #1c1a17);
    border-color: var(--ink, #1c1a17);
    color: var(--paper, #faf8f3);
  }
  .tour-tab:focus-visible {
    outline: 2px solid var(--indigo, #6554d9);
    outline-offset: 2px;
  }
  .tour-panel[hidden] {
    display: none;
  }
  .tour-figure {
    margin: 0 auto;
    max-width: 56rem;
  }
  .tour-figure img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--card, #fff);
    border: 1px solid var(--line, #e5e3dc);
    border-radius: var(--radius, 12px);
    box-shadow: 0 20px 40px -24px rgba(22, 24, 29, 0.25);
  }
  .tour-figure figcaption {
    text-align: center;
    margin-top: 0.875rem;
  }
  .tour-line {
    text-align: center;
    max-width: 40rem;
    margin: 1.25rem auto 0;
    font-size: 1.0625rem;
  }
</style>
