---
import Base from '../layouts/Base.astro';
---

<style>
  .not-found {
    width: min(640px, 100% - 2.5rem);
    margin-inline: auto;
    padding: 5rem 0 6rem;
    text-align: center;
  }
  .not-found-code {
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(3.5rem, 10vw, 5.5rem);
    font-weight: 700;
    color: var(--indigo, #6554d9);
    margin: 0 0 1rem;
    line-height: 1;
  }
  .not-found h1 {
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.6rem, 4vw, 2.25rem);
    margin: 0 0 0.75rem;
    color: var(--ink, #16181d);
  }
  .not-found p {
    color: var(--ink-muted, #6b6f78);
    line-height: 1.65;
    margin: 0 0 2rem;
  }
  .not-found-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>

<Base
  title="Page not found"
  description="The page you are looking for does not exist."
  path="/404"
  noindex
>
  <section class="not-found" data-reveal aria-labelledby="not-found-heading">
    <p class="not-found-code" aria-hidden="true">404</p>
    <h1 id="not-found-heading">Page not found</h1>
    <p>
      The page you are looking for does not exist or has been moved.
    </p>
    <div class="not-found-actions">
      <a class="btn btn-primary" href="/">Go home</a>
      <a class="btn btn-secondary" href="/products">Browse products</a>
    </div>
  </section>
</Base>

